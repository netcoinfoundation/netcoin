#
# macOS build of the headless daemon (netcoind) with the Homebrew packages,
# see doc/build-macos.md:
#
#   brew install boost openssl@3 sqlite leveldb miniupnpc berkeley-db
#   make -f makefile.osx -j"$(sysctl -n hw.ncpu)"
#   make -f makefile.osx test_netcoin

USE_UPNP ?= 1
USE_BDB ?= 1

BREW ?= $(shell brew --prefix)
OPENSSL_PREFIX ?= $(shell brew --prefix openssl@3)
SQLITE_PREFIX ?= $(shell brew --prefix sqlite)
BDB_PREFIX ?= $(shell brew --prefix berkeley-db)

CXX = clang++
CC = clang
MACOSX_DEPLOYMENT_TARGET ?= 14.0

DEFS = -DMAC_OSX -DMSG_NOSIGNAL=0 -DUSE_IPV6 -DBOOST_SPIRIT_THREADSAFE \
       -DBOOST_BIND_GLOBAL_PLACEHOLDERS -DOPENSSL_API_COMPAT=0x10100000L -DHAVE_BUILD_INFO
DEFS += -I$(CURDIR) -I$(CURDIR)/obj -I$(OPENSSL_PREFIX)/include -I$(SQLITE_PREFIX)/include -I$(BREW)/include

LIBS = -L$(OPENSSL_PREFIX)/lib -L$(SQLITE_PREFIX)/lib -L$(BREW)/lib \
   -lboost_filesystem -lboost_program_options -lboost_thread -lboost_chrono \
   -lsqlite3 -lleveldb -lssl -lcrypto -lz

ifeq (${USE_BDB}, 1)
	DEFS += -DENABLE_BDB_MIGRATION -I$(BDB_PREFIX)/include
	LIBS += -L$(BDB_PREFIX)/lib -ldb_cxx
endif

ifneq (${USE_UPNP}, -)
	DEFS += -DUSE_UPNP=$(USE_UPNP)
	LIBS += -lminiupnpc
endif

TESTDEFS = -DTEST_DATA_DIR=$(abspath test/data) -DBOOST_TEST_DYN_LINK

xCXXFLAGS = -std=c++17 -O2 -mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET) -pthread \
    -Wall -Wextra -Wformat -Wformat-security -Wno-unused-parameter -Wno-deprecated-declarations \
    -fstack-protector-all $(DEFS) $(CXXFLAGS)
xLDFLAGS = -mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET) -Wl,-dead_strip $(LDFLAGS)

OBJS= \
    obj/kernel.o \
    obj/alert.o \
    obj/version.o \
    obj/checkpoints.o \
    obj/netbase.o \
    obj/addrman.o \
    obj/crypter.o \
    obj/miner.o \
    obj/key.o \
    obj/db.o \
    obj/db_bdb.o \
    obj/torcontrol.o \
    obj/init.o \
    obj/keystore.o \
    obj/core.o \
    obj/main.o \
    obj/net.o \
    obj/protocol.o \
    obj/bitcoinrpc.o \
    obj/rpcblockchain.o \
    obj/rpcmining.o \
    obj/rpcdump.o \
    obj/rpcnet.o \
    obj/rpcrawtransaction.o \
    obj/rpcwallet.o \
    obj/script.o \
    obj/scrypt.o \
    obj/sync.o \
    obj/util.o \
    obj/wallet.o \
    obj/walletdb.o \
    obj/hash.o \
    obj/noui.o \
    obj/chainparams.o \
    obj/txdb-leveldb.o

all: netcoind

-include obj/*.d
-include obj-test/*.d

obj/build.h: FORCE
	@mkdir -p obj
	/bin/sh ../share/genbuild.sh obj/build.h
version.cpp: obj/build.h

obj/scrypt.o: scrypt.c
	@mkdir -p obj
	$(CC) -c -O2 -mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET) -I$(OPENSSL_PREFIX)/include $(CFLAGS) -o $@ $^

obj/%.o: %.cpp
	@mkdir -p obj
	$(CXX) -c $(xCXXFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<

# Homebrew's LevelDB is built without RTTI; a class derived from one of its
# classes (CBatchScanner) must be compiled the same way
obj/txdb-leveldb.o: txdb-leveldb.cpp
	@mkdir -p obj
	$(CXX) -c $(xCXXFLAGS) -fno-rtti -MMD -MF $(@:%.o=%.d) -o $@ $<

netcoind: $(OBJS)
	$(CXX) $(xCXXFLAGS) -o $@ $^ $(xLDFLAGS) $(LIBS)

TESTOBJS := $(patsubst test/%.cpp,obj-test/%.o,$(wildcard test/*.cpp))

obj-test/%.o: test/%.cpp
	@mkdir -p obj-test
	$(CXX) -c $(TESTDEFS) $(xCXXFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<

test_netcoin: $(TESTOBJS) $(filter-out obj/init.o,$(OBJS))
	$(CXX) $(xCXXFLAGS) -o $@ $^ $(xLDFLAGS) -lboost_unit_test_framework $(LIBS)

clean:
	rm -f netcoind test_netcoin
	rm -f obj/*.o obj/*.d obj-test/*.o obj-test/*.d obj/build.h

FORCE:
