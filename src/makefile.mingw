# file license.txt or http://www.opensource.org/licenses/mit-license.php.
#
# Windows build of the headless daemon (netcoind.exe) in an MSYS2 UCRT64 or
# MINGW64 shell, using the MSYS2 packages for all dependencies.
# See doc/build-windows.md.
#
#   make -f makefile.mingw -j4
#   make -f makefile.mingw test_netcoin.exe

USE_UPNP ?= 1
USE_BDB ?= 1
BOOST_LIB_SUFFIX ?= -mt

CXX ?= g++
CC ?= gcc

DEFS = -DWIN32 -D_WINDOWS -D_WIN32_WINNT=0x0601 -DWIN32_LEAN_AND_MEAN -DNOMINMAX \
       -DUSE_IPV6 -DBOOST_SPIRIT_THREADSAFE -DBOOST_BIND_GLOBAL_PLACEHOLDERS \
       -DOPENSSL_API_COMPAT=0x10100000L -DHAVE_BUILD_INFO
DEFS += -I$(CURDIR) -I$(CURDIR)/obj

LIBS = \
   -l boost_filesystem$(BOOST_LIB_SUFFIX) \
   -l boost_program_options$(BOOST_LIB_SUFFIX) \
   -l boost_thread$(BOOST_LIB_SUFFIX) \
   -l boost_chrono$(BOOST_LIB_SUFFIX) \
   -l sqlite3 \
   -l leveldb \
   -l ssl \
   -l crypto

ifeq (${USE_BDB}, 1)
	LIBS += -l db_cxx
	DEFS += -DENABLE_BDB_MIGRATION
endif

ifneq (${USE_UPNP}, -)
	LIBS += -l miniupnpc
	DEFS += -DUSE_UPNP=$(USE_UPNP)
endif

LIBS += -l ws2_32 -l mswsock -l iphlpapi -l shlwapi -l ole32 -l oleaut32 -l uuid \
        -l gdi32 -l user32 -l advapi32 -l shell32 -l crypt32 -l z

xCXXFLAGS = -std=c++17 -O2 -mthreads -Wall -Wextra -Wformat -Wformat-security \
            -Wno-unused-parameter -Wno-deprecated-copy $(DEFS) $(CXXFLAGS)
xLDFLAGS = -mthreads -Wl,--dynamicbase -Wl,--nxcompat -Wl,--high-entropy-va \
           -static-libgcc -static-libstdc++ $(LDFLAGS)

OBJS= \
    obj/kernel.o \
    obj/alert.o \
    obj/version.o \
    obj/checkpoints.o \
    obj/netbase.o \
    obj/addrman.o \
    obj/crypter.o \
    obj/miner.o \
    obj/key.o \
    obj/db.o \
    obj/db_bdb.o \
    obj/torcontrol.o \
    obj/init.o \
    obj/keystore.o \
    obj/core.o \
    obj/main.o \
    obj/net.o \
    obj/protocol.o \
    obj/bitcoinrpc.o \
    obj/rpcblockchain.o \
    obj/rpcmining.o \
    obj/rpcdump.o \
    obj/rpcnet.o \
    obj/rpcrawtransaction.o \
    obj/rpcwallet.o \
    obj/script.o \
    obj/scrypt.o \
    obj/sync.o \
    obj/util.o \
    obj/wallet.o \
    obj/walletdb.o \
    obj/hash.o \
    obj/noui.o \
    obj/chainparams.o \
    obj/txdb-leveldb.o

all: netcoind.exe

-include obj/*.d
-include obj-test/*.d

obj/build.h: FORCE
	@mkdir -p obj
	/bin/sh ../share/genbuild.sh obj/build.h
version.cpp: obj/build.h

obj/scrypt.o: scrypt.c
	@mkdir -p obj
	$(CC) -c -O2 $(CFLAGS) -o $@ $^

obj/%.o: %.cpp
	@mkdir -p obj
	$(CXX) -c $(xCXXFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<

netcoind.exe: $(OBJS)
	$(CXX) $(xCXXFLAGS) -o $@ $^ $(xLDFLAGS) $(LIBS)

TESTOBJS := $(patsubst test/%.cpp,obj-test/%.o,$(wildcard test/*.cpp))

obj-test/%.o: test/%.cpp
	@mkdir -p obj-test
	$(CXX) -c -DTEST_DATA_DIR=$(abspath test/data) -DBOOST_TEST_DYN_LINK $(xCXXFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<

test_netcoin.exe: $(TESTOBJS) $(filter-out obj/init.o,$(OBJS))
	$(CXX) $(xCXXFLAGS) -o $@ $^ -l boost_unit_test_framework$(BOOST_LIB_SUFFIX) $(xLDFLAGS) $(LIBS)

clean:
	rm -f netcoind.exe test_netcoin.exe
	rm -f obj/*.o obj/*.d obj-test/*.o obj-test/*.d obj/build.h

FORCE:
